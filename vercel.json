{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "index.html",
          "login.html",
          "register.html",
          "admin.html",
          "favicon.svg",
          "manifest.webmanifest",
          "sw.js",
          "robots.txt",
          "sitemap.xml",
          "app/static/**",
          "assets/**",
          "instance/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
